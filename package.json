{
  "private": true,
  "name": "omaps-url-handler",
  "version": "1.0.0",
  "description": "Processes specific HTTP requests to domains",
  "main": "workers-site/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=workers-site/index.js",
    "lint": "oxlint --deny-warnings src && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write 'src/**/*.{ts,tsx,json}' public/*.json",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,json}' public/*.json",
    "upgrade": "npx npm-check-updates --peer -u && npm install"
  },
  "author": "Alexander Borsuk <me@alex.bio>",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.5.0"
  }
}
